{{!--
  The GM's view of a round: the band the players are looking at, ranked fastest
  first and carrying what only the GM needs — the gap behind the leader, how
  many are still out, and the controls to end the round.
--}}
<div class="break-stage">
  <div class="break-headline">{{headline}}</div>

  <div class="break-band">
    <div class="break-clock {{#if expired}}spent{{/if}}" data-clock>{{clock}}</div>

    {{#if duration}}
      <div class="break-timer {{#if expired}}spent{{/if}}">
        <div
          class="break-timer-fill"
          style="animation-duration: {{duration}}s; animation-delay: {{countdownDelay}}s"
        ></div>
      </div>
    {{/if}}

    {{#if participants.length}}
      <div class="break-roster">
        {{#each participants}}
          {{> "modules/break/templates/roster-card.hbs"}}
        {{/each}}
      </div>
    {{else}}
      <div class="break-gm-note">Nobody else is connected.</div>
    {{/if}}
  </div>

  <div class="break-gm-bar">
    <div class="break-gm-status">
      <span class="break-gm-count">{{answered}} of {{total}} in</span>
      {{#if limit}}
        <span class="break-gm-note">Keeping the fastest {{limit}}.</span>
      {{/if}}
    </div>

    {{#if active}}
      <div class="break-gm-controls">
        <button type="button" class="break-gm-button" data-action="dismiss">End Round</button>
        <button type="button" class="break-gm-button quiet" data-action="cancel">Cancel</button>
      </div>
    {{/if}}
  </div>
</div>
