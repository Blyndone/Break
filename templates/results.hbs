<div class="break-results">
  <div class="break-results-prompt">{{headline}}</div>

  {{#if limit}}
    <div class="break-results-note">Keeping the fastest {{limit}}.</div>
  {{/if}}

  {{#if order.length}}
    <ol class="break-results-order">
      {{#each order}}
        <li class="{{#if this.cut}}cut{{/if}}">
          <span class="break-results-rank">{{this.rank}}</span>
          <img class="break-results-portrait" src="{{this.img}}" alt="{{this.name}}" />
          <span class="break-results-name">{{this.name}}</span>
          <span class="break-results-elapsed">{{this.elapsed}} ms</span>
        </li>
      {{/each}}
    </ol>
  {{else}}
    <div class="break-results-note">No responses yet.</div>
  {{/if}}

  {{#if pending.length}}
    <ol class="break-results-order pending">
      {{#each pending}}
        <li>
          <span class="break-results-rank">&ndash;</span>
          <img class="break-results-portrait" src="{{this.img}}" alt="{{this.name}}" />
          <span class="break-results-name">{{this.name}}</span>
          <span class="break-results-elapsed">&hellip;</span>
        </li>
      {{/each}}
    </ol>
  {{/if}}

  {{#if active}}
    <button type="button" data-action="dismiss">End Round</button>
  {{/if}}
</div>
