{
  "title": "Break",
  "id": "break",
  "description": "A player buzzer for Foundry VTT. The GM calls a break, every player gets a full width prompt, and the fastest to respond act first. Each client times its own player, so turn order comes from reaction speed rather than from latency or an initiative roll.",
  "version": "#{VERSION}#",
  "authors": [
    {
      "name": "Blyndone",
      "url": "https://github.com/Blyndone",
      "flags": {}
    }
  ],
  "compatibility": {
    "minimum": "13.302",
    "verified": "13.351",
    "maximum": "13.999"
  },
  "relationships": {
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "compatibility": {}
      }
    ]
  },
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    "styles/styles.css"
  ],
  "socket": true,
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#",
  "license": "LICENSE",
  "readme": "README.md",
  "bugs": "https://github.com/Blyndone/Break/issues",
  "changelog": "https://github.com/Blyndone/Break/releases",
  "media": [
    {
      "type": "icon",
      "loop": false,
      "flags": {}
    }
  ]
}
